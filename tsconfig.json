{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "types": ["node"]
    },
    "include": ["playwright.config.ts", "playwright.visual.config.ts", "tests/**/*.ts"]
}
