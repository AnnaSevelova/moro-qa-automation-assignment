{
  "name": "qa-automation-assignment",
  "version": "1.0.0",
  "description": "Playwright GUI and API tests for the MoroSystems automation tester assignment",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "npm ci --prefix apps/todo-be",
    "api:start": "npm start --prefix apps/todo-be",
    "api:generate": "node scripts/generate-api-types.mjs",
    "test:gui": "playwright test --project=\"gui-*\" --grep-invert @live",
    "test:gui:live": "playwright test --project=gui-chromium --grep @live --workers=1",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:docker": "bash scripts/visual-docker.sh",
    "test:visual:docker:update": "bash scripts/visual-docker.sh --update",
    "test:visual:report": "playwright show-report test-output/visual-report",
    "test:report": "playwright show-report test-output/report",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "eslint": "9.39.4",
    "eslint-plugin-playwright": "2.10.4",
    "globals": "17.6.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
